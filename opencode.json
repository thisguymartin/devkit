{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode/gpt-5.4",
  "small_model": "opencode/gpt-5.4-mini",

  "agent": {
    "plan": {
      "model": "opencode/gemini-3.1-pro",
      "description": "Default Plan mode — architecture, debugging, analysis (read-only)"
    },
    "build": {
      "model": "opencode/gpt-5.4",
      "description": "Default Build mode — implementation, editing, running tests"
    }
  },

  "instructions": [
    "skills/rules/code-quality-standards.md",
    "skills/rules/engineering-principles.md",
    "skills/rules/development-workflow.md",
    "skills/rules/security-awareness.md"
  ],

  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "@linear/mcp-server"],
      "environment": {
        "LINEAR_API_KEY": "{env:LINEAR_API_KEY}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "enabled": false
    }
  },

  "plugin": [
    "@ramtinj95/opencode-tokenscope"
  ],

  "tools": {
    "filesystem*": false
  }
}
